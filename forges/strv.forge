
version: 0
product_name: "Strive"
monitoring: true
vscode: true
apps:
  - name: backend
    type: go-backend
  - name: frontend
    type: react-frontend
    backend: backend
    brand_color_rgb: "4, 47, 46"
features:
  - name: athlete_profile
    fields:
      - name: user_id
        type: id
      - name: age
        type: number
      - name: height
        type: number
      - name: body_weight
        type: number
  - name: coach_profile
    fields:
      - name: user_id
        type: id
      - name: bio
        type: text
      - name: website_url
        type: text
  - name: organization
    fields:
      - name: id
        type: id
      - name: name
        type: text
      - name: kind
        type: string
      - name: owner_user_id
        type: id
  - name: organization_member
    fields:
      - name: org_id
        type: id
      - name: user_id
        type: id
      - name: role
        type: string
      - name: status
        type: string
  - name: bodybuilding_plan_template
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: name
        type: string
      - name: category
        type: string
      - name: version
        type: number
      - name: status
        type: string
      - name: metadata
        type: text
      - name: content
        type: text
  - name: bodybuilding_plan_program
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: template_id
        type: id
      - name: name
        type: text
      - name: weeks
        type: number
      - name: personalization
        type: text
  - name: bodybuilding_plan_block
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: program_id
        type: id
      - name: block_index
        type: number
      - name: length_days
        type: number
      - name: start_offset_days
        type: number
  - name: bodybuilding_plan_session
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: block_id
        type: id
      - name: session_index
        type: number
      - name: days_offset
        type: number
      - name: name
        type: string
      - name: notes
        type: text
  - name: bodybuilding_plan_exercise
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: session_id
        type: id
      - name: order_index
        type: number
      - name: exercise_key
        type: string
      - name: target_sets
        type: number
      - name: target_reps
        type: string
      - name: target_load
        type: number
      - name: target_rpe
        type: number
      - name: rest_sec
        type: number
      - name: notes
        type: text
  - name: plan_assignment
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: program_id
        type: id
      - name: athlete_user_id
        type: id
      - name: coach_user_id
        type: id
      - name: start_date
        type: date
      - name: status
        type: string
      - name: tz
        type: string
  - name: assignment_schedule_rules
    fields:
      - name: id
        type: id
      - name: assignment_id
        type: id
      - name: session_id
        type: id
      - name: rule
        type: text
  - name: assignment_session_exceptions
    fields:
      - name: id
        type: id
      - name: assignment_id
        type: id
      - name: session_id
        type: id
      - name: original_date
        type: date
      - name: status
        type: text
      - name: new_date
        type: date
      - name: note
        type: text
  - name: exercise_entry
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: assignment_id
        type: id
      - name: program_id
        type: id
      - name: session_id
        type: id
      - name: session_entry_id
        type: id
      - name: exercise_name
        type: string
      - name: scheduled_date
        type: date
      - name: performed_at
        type: date
      - name: rpe_session
        type: number
      - name: notes
        type: text
  - name: set_entries
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: workout_entry_id
        type: id
      - name: exercise_id
        type: id
      - name: set_index
        type: number
      - name: load_kg
        type: number
      - name: reps
        type: number
      - name: rpe
        type: number
      - name: rest_sec
        type: number
      - name: completed
        type: boolean
  - name: session_entry
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: assignment_id
        type: id
      - name: program_id
        type: id
      - name: plan_session_id
        type: id
      - name: session_name
        type: string
      - name: started_at
        type: datetime
      - name: rpe_session
        type: number
      - name: notes
        type: text

  # --------------------------
  # FOOD CATALOG
  # --------------------------
  - name: food
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: name
        type: text
      - name: brand
        type: text
      - name: barcode
        type: text
      - name: source
        type: string     # e.g., 'manual', 'off', 'usda'
      - name: lang
        type: string     # e.g., 'en', 'hu'
      - name: is_custom
        type: bool
      - name: created_by_user
        type: id
      - name: kcal_per_100g
        type: number
      - name: protein_per_100g
        type: number
      - name: fat_per_100g
        type: number
      - name: carbs_per_100g
        type: number
      - name: nutrients_json
        type: text        # optional micronutrients, e.g. {"fiber":2.7}
      - name: density_g_per_ml
        type: number
      - name: created_at
        type: datetime
      - name: updated_at
        type: datetime

  - name: food_measure
    fields:
      - name: id
        type: id
      - name: food_id
        type: id                    # references food.id
      - name: label
        type: text                  # e.g., "large egg", "cup", "slice"
      - name: grams
        type: number
      - name: ml
        type: number
      - name: is_default
        type: bool

  - name: meal_entry
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: user_id
        type: id
      - name: meal_type
        type: string      # e.g., breakfast, lunch, dinner, snack
      - name: name
        type: text        # optional, like "Omelette"
      - name: notes
        type: text
      - name: served_at
        type: datetime
      - name: tz
        type: string
      - name: created_at
        type: datetime
      - name: updated_at
        type: datetime

  - name: meal_item
    fields:
      - name: id
        type: id
      - name: org_id
        type: id
      - name: meal_entry_id
        type: id                    # references meal_entry.id
      - name: food_id
        type: id                    # references food.id
      - name: food_measure_id
        type: id         # references food_measure.id
      - name: quantity
        type: number
      - name: grams_override
        type: number
      - name: order_index
        type: number
      - name: notes
        type: text
      - name: created_at
        type: datetime
      - name: updated_at
        type: datetime